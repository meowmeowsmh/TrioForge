# ──────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
wheels/

# Virtual environments
.venv/
.venv-linux/
venv/
env/
ENV/

# ──────────────────────────────────────────────────────────────
# Testing / linting / coverage
# ──────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ──────────────────────────────────────────────────────────────
# Environment variables / secrets
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────────────────────────────────────
# Editors / OS
# ──────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────
# Logs & databases
# ──────────────────────────────────────────────────────────────
*.log
*.db
*.sqlite
*.sqlite3

# ──────────────────────────────────────────────────────────────
# App: local user data (everyone keeps their own)
# ──────────────────────────────────────────────────────────────
json_configuration/attachments
json_configuration/conversations.json
json_configuration/model_config.json
json_configuration/corkboard.json
json_configuration/notes.json
json_configuration/sync_config.json
json_configuration/workspaces/
# Host mode: the shared password and the session-signing key. Never commit these.
json_configuration/host_password
json_configuration/.host_secret
sqlite_data/

# ──────────────────────────────────────────────────────────────
# App: generated SSL certificates + downloaded mkcert
# ──────────────────────────────────────────────────────────────
cert_store/
mkcert.exe

# ──────────────────────────────────────────────────────────────
# App: uploaded user files (user-specific and can be large)
# ──────────────────────────────────────────────────────────────
static/uploads/

# ──────────────────────────────────────────────────────────────
# Models (large local weights) — NEVER commit any model files.
# Each model root is ignored wholesale so no weights, projectors,
# Modelfiles, or download caches leak into the repo.
# ──────────────────────────────────────────────────────────────
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt

# Model folders (llama.cpp / Ollama / ComfyUI local weights)
/models/
/video_model/
/universal_models_to_text/

# Auto-installed llama.cpp binaries (downloaded by llama_installer / ⚡ Auto-install)
tools/llama.cpp/

# Auto-installed ffmpeg (downloaded by ffmpeg_installer / ⚡ Install ffmpeg).
# ~150 MB archive + extracted binaries: machine state, never commit.
tools/ffmpeg/

# Hugging Face / Ollama download caches
models/.cache/
.cache/huggingface/

# ──────────────────────────────────────────────────────────────
# ComfyUI media generation (downloads + output, user-specific)
# ──────────────────────────────────────────────────────────────
static/uploads/generated/
static/uploads/generated_video/

# ──────────────────────────────────────────────────────────────
# Personal / scratch files
# ──────────────────────────────────────────────────────────────
personal.txt
weather.html

# Voice agent conversation logs + control file (kept locally, not committed)
voiceguide_llama.cpp_guide/*.log
voiceguide_llama.cpp_guide/control.txt

# Machine state, not source: records which dependency manifests the local venv has.
# It must NEVER be committed - a fresh clone carrying an empty marker made the
# launcher skip the dependency install, and the app then crashed on import.
.deps_installed

# Control panel pid file (one panel per folder)
logs/control-panel.pid

# WebView2 profile (cookies, cache, localStorage) - machine state, never commit
json_configuration/webview/
app_window.pid
