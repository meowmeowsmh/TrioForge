#!/usr/bin/env bash
# ============================================================
#  forge / trioforge — launch the TrioForge terminal client.
#
#  Both names run this same script (trioforge is a symlink to it):
#      trioforge                   interactive session
#      trioforge what is a GGUF?   one-shot question
#      trioforge --echo            offline demo, no model needed
#      trioforge --version         print the version
#      trioforge --help            all options
#
#  It is independent of the Flask web GUI: nothing here imports app.py.
#
#  It also installs anything missing before launching, so a fresh `git clone` and
#  a `git pull` both just work. Set TRIOFORGE_SKIP_DEPS=1 to opt out.
# ============================================================
set -euo pipefail

# Resolve symlinks: readlink -f follows the whole chain to the real script, so a
# link dropped in ~/.local/bin (e.g. trioforge) still finds the repo root.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"

# Tell the CLI which name the user typed, so --help/--version print that name.
export FORGE_PROG="${FORGE_PROG:-$(basename "$0")}"

# ---------------------------------------------------------------- dependencies
# A fresh clone has no venv and no packages, and `git pull` can add a dependency.
# Rather than making anyone remember a step, install what is missing first: the
# alternative is ModuleNotFoundError on the very first run, which reads as a
# broken app. The check is a bash hash of the requirement files, so a normal
# start pays about 10ms and nothing else.
# shellcheck source=deps.sh
. "$ROOT/deps.sh"

if [ "${TRIOFORGE_SKIP_DEPS:-0}" != "1" ]; then
    forge_ensure_deps "$ROOT" || true   # it reports its own failure; still try to run
fi

# ---------------------------------------------------------------- interpreter
# Prefer the Linux venv (where the deps were just installed), then the
# Windows-style layout, then whatever python3 is on PATH.
PY="$(forge_venv_python "$ROOT" 2>/dev/null || true)"
if [ -z "${PY:-}" ]; then
    PY="$(command -v python3 || true)"
fi

if [ -z "${PY:-}" ] || [ ! -x "$PY" ]; then
    echo "forge: no python interpreter found — run ./setup.sh" >&2
    exit 1
fi

# The tui package lives under py/, alongside app.py and providers/.
export PYTHONPATH="$ROOT/py${PYTHONPATH:+:$PYTHONPATH}"

exec "$PY" -m tui "$@"
