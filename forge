#!/usr/bin/env bash
# ============================================================
#  forge / trioforge — launch the TrioForge terminal client.
#
#  Both names run this same script (trioforge is a symlink to it):
#      trioforge                   interactive session
#      trioforge what is a GGUF?   one-shot question
#      trioforge --echo            offline demo, no model needed
#      trioforge --version         print the version
#      trioforge --help            all options
#
#  It is independent of the Flask web GUI: nothing here imports app.py.
# ============================================================
set -euo pipefail

# Resolve symlinks: readlink -f follows the whole chain to the real script, so a
# link dropped in ~/.local/bin (e.g. trioforge) still finds the repo root.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"

# Tell the CLI which name the user typed, so --help/--version print that name.
export FORGE_PROG="${FORGE_PROG:-$(basename "$0")}"

# Prefer the Linux venv (where rich + prompt_toolkit were installed), then the
# Windows-style layout, then whatever python3 is on PATH.
PY="$ROOT/.venv-linux/bin/python"
[ -x "$PY" ] || PY="$ROOT/.venv/bin/python3"
[ -x "$PY" ] || PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"

if [ ! -x "$PY" ]; then
    echo "forge: no python interpreter found" >&2
    exit 1
fi

# The tui package lives under py/, alongside app.py and providers/.
export PYTHONPATH="$ROOT/py${PYTHONPATH:+:$PYTHONPATH}"

exec "$PY" -m tui "$@"
